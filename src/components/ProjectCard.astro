---
// Tarjeta de un caso para la portada y los listados.
import { caseUrl, mediaUrl, type Case } from '../lib/cases';
import { pick, type Lang } from '../lib/i18n';

interface Props { c: Case; index: number; lang: Lang }
const { c, index, lang } = Astro.props;
const { title, category, card } = c.data;
const delay = (index % 2) * 80;
const alt = pick(lang, card.alt ?? title);
---
<a href={caseUrl(c, lang)} class="project-card" data-reveal style={`--reveal-delay:${delay}ms`}>
  <div class="project-img-wrap">
    {card.video
      ? <video src={mediaUrl(c, card.video)} autoplay muted loop playsinline aria-label={alt}></video>
      : <img src={mediaUrl(c, card.thumb)} alt={alt} loading="lazy">}
  </div>
  <div class="project-meta">
    <div class="project-title">{pick(lang, title)}</div>
    <div class="project-category">{pick(lang, category)}</div>
  </div>
</a>

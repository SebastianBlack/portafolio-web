---
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
  <footer id="footer" data-section>
    <div>
      <div class="footer-address" data-i18n="footer.address">{t(lang, 'footer.address')}</div>
      <div class="footer-social">
        <a href="https://www.instagram.com/sebasblack.pe/" target="_blank" rel="noopener" data-cta="instagram">Instagram</a>
        <a href="https://www.linkedin.com/in/sebastianblack/" target="_blank" rel="noopener" data-cta="linkedin">LinkedIn</a>
        <a href="mailto:hola.sebastianblack@gmail.com" data-cta="email">Email</a>
      </div>
    </div>

    <div class="footer-center">
      <p class="footer-cta-title" data-i18n="footer.cta" set:html={t(lang, 'footer.cta')} />
      <a href="https://wa.me/51992325564" class="btn-pill" target="_blank" rel="noopener" data-i18n="footer.connect" aria-label={t(lang, 'footer.connect-aria')} data-i18n-aria="footer.connect-aria" data-cta="whatsapp">{t(lang, 'footer.connect')}</a>
      <p class="footer-copy" data-i18n="footer.copy">{t(lang, 'footer.copy')}</p>
    </div>

    <div class="footer-right">
      <a href="#" class="footer-back-top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;" data-i18n="footer.back">{t(lang, 'footer.back')}</a>
    </div>
  </footer>

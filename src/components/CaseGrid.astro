---
// Grilla de casos filtrada por categoría (product | branding | all).
import ProjectCard from './ProjectCard.astro';
import { getListedCases, caseTag } from '../lib/cases';

interface Props { tag: 'product' | 'branding' | 'all' }
const { tag } = Astro.props;
const list = (await getListedCases()).filter((c) => tag === 'all' || caseTag(c) === tag);
---
<div class="projects-grid" data-tag={tag}>
  {list.map((c, i) => <ProjectCard c={c} index={i} />)}
</div>

---
// Una imagen o un video de un caso, con pie de foto opcional.
import { isVideo } from '../lib/cases';

interface Props {
  src: string;
  alt: string;
  delay?: number;
  reveal?: boolean;
  eager?: boolean;
  caption?: string;
}
const { src, alt, delay = 0, reveal = true, eager = false, caption } = Astro.props;
// Con pie de foto, la animación de entrada pasa al <figure> para que imagen y pie entren juntos.
const revealMedia = reveal && !caption;
const style = delay ? `--reveal-delay:${delay}ms` : undefined;
---
{caption
  ? (
    <figure class="case-figure" data-reveal={reveal ? '' : undefined} style={style}>
      {isVideo(src)
        ? <video src={src} autoplay muted loop playsinline aria-label={alt}></video>
        : <img src={src} alt={alt} loading={eager ? undefined : 'lazy'}>}
      <figcaption class="case-caption">{caption}</figcaption>
    </figure>
  )
  : isVideo(src)
    ? <video src={src} autoplay muted loop playsinline aria-label={alt} data-reveal={revealMedia ? '' : undefined} style={style}></video>
    : <img src={src} alt={alt} loading={eager ? undefined : 'lazy'} data-reveal={revealMedia ? '' : undefined} style={style}>}

---
// Al tocar ES/EN, la página en el otro idioma se abre en el mismo lugar exacto.
//
// Al salir se guarda el elemento que está en el borde superior de la pantalla (título,
// párrafo, imagen…) por su posición en la lista de elementos de la página, que es la
// misma en los dos idiomas, y qué fracción de ese elemento ya pasó. No se guardan píxeles
// de página: cada idioma mide distinto.
//
// Al llegar, la página se mantiene oculta hasta que la fuente está lista, se coloca ese
// elemento en la misma posición y recién entonces se muestra: no se ve arriba y luego saltar.
// Para que el cálculo sea exacto, todas las imágenes tienen proporción fija en el CSS.
//
// Va en el <head> para poder ocultar la página antes del primer pintado.
---
<script is:inline>
  (function () {
    var KEY = 'lang-switch';
    var SEL = 'h1, h2, h3, p, li, img, video, figcaption, .meta-value, .about-list, .btn-pill, .contact-social-link';
    // Fuera de la lista: menú, elementos fijos o pegajosos, y la estela decorativa.
    var SKIP = '.nav, .nav-mobile, .skip-link, .cursor-ring, .hero-trail, .about-right, .hero-logo-wrap, .hero-logo-mobile';
    var root = document.documentElement;

    function anchors() {
      return Array.prototype.filter.call(document.body.querySelectorAll(SEL), function (el) {
        return !el.closest(SKIP);
      });
    }

    // ¿Volvemos del botón de idioma a esta misma página?
    var saved = null;
    try {
      saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      sessionStorage.removeItem(KEY);
    } catch (e) {}
    var restore = saved && saved.path === location.pathname && !location.hash;
    if (restore) {
      root.classList.add('lang-restore', 'lang-jump');
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      // Red de seguridad: pase lo que pase, la página se muestra.
      setTimeout(function () { root.classList.remove('lang-restore', 'lang-jump'); }, 1500);
    }

    // Posición sin el desplazamiento de la animación de aparición (translateY de [data-reveal]),
    // por si se toca ES/EN mientras un elemento todavía está entrando.
    function rect(el) {
      var r = el.getBoundingClientRect(), shift = 0;
      for (var x = el.closest('[data-reveal]'); x; x = x.parentElement && x.parentElement.closest('[data-reveal]')) {
        var t = getComputedStyle(x).transform;
        if (t && t !== 'none' && window.DOMMatrix) shift += new DOMMatrix(t).m42;
      }
      return { top: r.top - shift, bottom: r.bottom - shift, height: r.height };
    }

    function save(href) {
      var list = anchors(), best = null, below = null;
      if (window.scrollY > 0) {
        list.forEach(function (el, i) {
          var r = rect(el);
          if (!r.height) return;
          // El elemento que cruza el borde superior; si hay varios anidados, el más chico.
          if (r.top <= 0 && r.bottom > 0 && (!best || r.height < best.h)) best = { i: i, h: r.height, f: -r.top / r.height };
          if (r.top > 0 && !below) below = { i: i, px: r.top };
        });
      }
      try {
        var data = best ? { i: best.i, f: best.f } : below ? { i: below.i, px: below.px } : null;
        if (data) {
          data.n = list.length;
          data.path = new URL(href, location.href).pathname;
          sessionStorage.setItem(KEY, JSON.stringify(data));
        } else sessionStorage.removeItem(KEY);
      } catch (e) {}
    }

    function place() {
      var list = anchors();
      var el = list.length === saved.n ? list[saved.i] : null;
      if (el) {
        var r = el.getBoundingClientRect();
        // Elemento cruzando el borde: misma fracción. Si no, mismo espacio hasta el borde.
        var top = r.top + window.scrollY + (saved.f != null ? saved.f * r.height : -saved.px);
        window.scrollTo({ top: Math.round(top), behavior: 'instant' });
      }
      // Lo que está a la vista (o arriba) aparece de una vez, sin animación de entrada.
      document.querySelectorAll('[data-reveal]').forEach(function (r) {
        if (r.getBoundingClientRect().top < window.innerHeight) r.classList.add('is-visible');
      });
      root.classList.remove('lang-restore');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { root.classList.remove('lang-jump'); });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('a.nav-lang, a.nav-mobile-footer-lang').forEach(function (a) {
        a.addEventListener('click', function () { save(a.href); });
      });
      if (!restore) return;
      // Se espera la fuente (desde caché suele estar lista al instante) para medir el texto
      // con su alto final. Si tarda, se coloca igual a los 500 ms.
      var fonts = document.fonts && document.fonts.load
        ? Promise.all(['400', '500', '700'].map(function (w) { return document.fonts.load(w + ' 16px Switzer'); }))
        : Promise.resolve();
      var timeout = new Promise(function (ok) { setTimeout(ok, 500); });
      Promise.race([fonts, timeout]).then(place, place);
    });
  })();
</script>

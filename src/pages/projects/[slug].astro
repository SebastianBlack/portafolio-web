---
// Página de cada caso de estudio. El contenido sale de src/content/cases/<slug>/case.yaml.
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import CaseMedia from '../../components/CaseMedia.astro';
import { getBuiltCases, getListedCases, caseUrl, mediaUrl, Dict, type Case } from '../../lib/cases';

export async function getStaticPaths() {
  const cases = await getBuiltCases();
  return cases.map((c) => ({ params: { slug: c.id }, props: { c } }));
}

const { c } = Astro.props as { c: Case };
const d = c.data;
const id = c.id;
const dict = new Dict();
const k = (path: string, value: { es: string; en: string }) => dict.add(`case.${id}.${path}`, value);

// Siguiente proyecto: el que sigue en el orden de los casos visibles (vuelve al primero al final).
const listed = await getListedCases();
const pos = listed.findIndex((x) => x.id === id);
const next = listed.length ? listed[(pos + 1) % listed.length] : undefined;

const header = {
  category: k('category', d.category),
  services: k('services', d.services),
  tagline: k('tagline', d.tagline),
  heroAlt: k('hero.alt', d.hero.alt),
};

const blocks = d.blocks.map((b, i) => {
  const p = `b${i}`;
  const item = (m: { src: string; alt: { es: string; en: string } }, j: number) => ({
    src: mediaUrl(c, m.src),
    alt: m.alt.es,
    altKey: k(`${p}.${j}.alt`, m.alt),
  });
  switch (b.type) {
    case 'text':
      return { type: b.type, eyebrow: b.eyebrow.es, eyebrowKey: k(`${p}.eyebrow`, b.eyebrow),
        heading: b.heading.es, headingKey: k(`${p}.heading`, b.heading),
        body: b.body.es, bodyKey: k(`${p}.body`, b.body) };
    case 'grid-2':
    case 'grid-3':
      return { type: b.type, items: b.items.map(item) };
    case 'wide':
    case 'full':
      return { type: b.type, items: [item(b.item, 0)] };
  }
});
---
<ProjectLayout
  title={d.seo.title.es}
  description={d.seo.description.es}
  noindex={d.status === 'hidden'}
  dict={dict}
>

  <div class="project-header">
    <div class="project-header-left">
      <h1 class="project-title" data-i18n={`project.${id}.title`}>{d.title.es}</h1>
      <p class="project-tagline" data-i18n={header.tagline}>{d.tagline.es}</p>
    </div>
    <div class="project-header-right">
      <div class="project-meta-grid">
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.category">Categoría</div>
          <div class="meta-value" data-i18n={header.category}>{d.category.es}</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.year">Año</div>
          <div class="meta-value">{d.year}</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.client">Cliente</div>
          <div class="meta-value">{d.client}</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.services">Servicios</div>
          <div class="meta-value" data-i18n={header.services}>{d.services.es}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="project-hero">
    <CaseMedia src={mediaUrl(c, d.hero.src)} alt={d.hero.alt.es} altKey={header.heroAlt} reveal={false} eager />
  </div>

  {blocks.map((b) => {
    if (b.type === 'text') return (
      <div class="content-section" data-reveal>
        <div class="content-text">
          <div>
            <p class="content-eyebrow" data-i18n={b.eyebrowKey}>{b.eyebrow}</p>
            <h2 class="content-heading" data-i18n={b.headingKey}>{b.heading}</h2>
          </div>
          <div class="content-body">
            <p data-i18n={b.bodyKey}>{b.body}</p>
          </div>
        </div>
      </div>
    );
    const wrap = { 'grid-2': 'img-grid-2', 'grid-3': 'img-grid-3', wide: 'img-padded', full: 'img-full' }[b.type];
    return (
      <div class="content-section">
        <div class={wrap}>
          {b.items.map((m, j) => <CaseMedia {...m} delay={j * 80} />)}
        </div>
      </div>
    );
  })}

  {next && (
    <a class="next-project" id="next-link" href={caseUrl(next)}>
      <p class="next-label" data-i18n="next.project">Siguiente proyecto</p>
      <h2 class="next-title" data-i18n={`project.${next.id}.title`}>{next.data.title.es}</h2>
      <span class="next-arrow">→</span>
    </a>
  )}

  <script is:inline>
  (function () {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
    const ring = document.getElementById('cursorRing');
    const next = document.getElementById('next-link');
    if (!ring || !next) return;
    let mx=0,my=0,cx=0,cy=0;
    document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; }, { passive: true });
    (function loop(){ cx+=(mx-cx)*0.14; cy+=(my-cy)*0.14; ring.style.left=cx+'px'; ring.style.top=cy+'px'; requestAnimationFrame(loop); })();
    next.addEventListener('mouseenter', () => ring.classList.add('is-active'));
    next.addEventListener('mouseleave', () => ring.classList.remove('is-active'));
  })();
  </script>
</ProjectLayout>

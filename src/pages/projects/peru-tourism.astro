---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---
<ProjectLayout title="Peru Tourism">

  <div class="project-header">
    <div class="project-header-left">
      <h1 class="project-title" data-i18n="project.peru-tourism.title">Peru Tourism</h1>
      <p class="project-tagline" data-i18n="project.peru-tourism.tagline"></p>
    </div>
    <div class="project-header-right">
      <div class="project-meta-grid">
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.category">Categoría</div>
          <div class="meta-value" data-i18n="project.peru-tourism.category">Diseño de Producto</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.year">Año</div>
          <div class="meta-value">2026</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.client">Cliente</div>
          <div class="meta-value">Alaz</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.services">Servicios</div>
          <div class="meta-value" data-i18n="project.peru-tourism.services">UX/UI Design</div>
        </div>
      </div>
    </div>
  </div>

  <div class="project-hero">
    <img src="/images/peru-tourism/hero.webp" alt="Peru Tourism">
  </div>

  <!-- 1: El Problema -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.problem">El Problema</p>
        <h2 class="content-heading" data-i18n="project.peru-tourism.s1.heading">Contexto y desafío</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.peru-tourism.s1.body">El 70% del tráfico era móvil, pero el sitio no estaba preparado. La arquitectura de información era redundante, mantenía contenido obsoleto y el formulario de contacto vertical generaba alta fricción para la captación de leads.</p>
      </div>
    </div>
  </div>

  <div class="content-section">
    <div class="img-grid-2">
      <img src="/images/peru-tourism/01.webp" alt="" data-reveal>
      <img src="/images/peru-tourism/02.webp" alt="" data-reveal style="--reveal-delay:80ms">
    </div>
  </div>

  <!-- 2: Estrategia -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.strategy">Estrategia</p>
        <h2 class="content-heading" data-i18n="project.peru-tourism.s2.heading">Enfoque mobile-first</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.peru-tourism.s2.body">Priorizar la experiencia mobile-first para capturar turistas. Se definió limpiar la arquitectura y enfocar la conversión en un nuevo flujo de personalización de viajes, cerrando con un formulario optimizado de baja carga cognitiva.</p>
      </div>
    </div>
  </div>

  <div class="content-section">
    <div class="img-grid-3">
      <img src="/images/peru-tourism/01v.webp" alt="" data-reveal>
      <img src="/images/peru-tourism/02v.webp" alt="" data-reveal style="--reveal-delay:80ms">
      <video src="/images/peru-tourism/03v.mp4" autoplay muted loop playsinline data-reveal style="--reveal-delay:160ms"></video>
    </div>
  </div>

  <!-- 3: Proceso -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.process">Proceso</p>
        <h2 class="content-heading" data-i18n="project.peru-tourism.s3.heading">Diseña tu viaje</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.peru-tourism.s3.body">Diseñé el flujo "Diseña tu viaje", categorizando opciones por tipo de experiencia. Transformé el formulario extenso en un multi-step form guiado, mostrando máximo dos inputs por vista para facilitar la digestión de la información.</p>
      </div>
    </div>
  </div>

  <div class="content-section">
    <div class="img-padded">
      <img src="/images/peru-tourism/wide-01.webp" alt="Peru Tourism" data-reveal>
    </div>
  </div>

  <!-- 4: Resultados -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.results">Resultados</p>
        <h2 class="content-heading" data-i18n="project.peru-tourism.s4.heading">Impacto</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.peru-tourism.s4.body">El rediseño del formulario agilizó el cierre del flujo de leads. A nivel técnico, la plataforma logró una velocidad de carga 3× más rápida, garantizando una experiencia de usuario móvil fluida y sin interrupciones.</p>
      </div>
    </div>
  </div>

  <a class="next-project" id="next-link" href="/">
    <p class="next-label" data-i18n="next.project">Siguiente proyecto</p>
    <h2 class="next-title" id="next-title">—</h2>
    <span class="next-arrow">→</span>
  </a>

<script is:inline>
  (function () {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
    const ring = document.getElementById('cursorRing');
    const next = document.getElementById('next-link');
    let mx=0,my=0,cx=0,cy=0;
    document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; }, { passive: true });
    (function loop(){ cx+=(mx-cx)*0.14; cy+=(my-cy)*0.14; ring.style.left=cx+'px'; ring.style.top=cy+'px'; requestAnimationFrame(loop); })();
    next.addEventListener('mouseenter', () => ring.classList.add('is-active'));
    next.addEventListener('mouseleave', () => ring.classList.remove('is-active'));
  })();
  (function () {
    const visible = PROJECTS.filter(function(p){ return !p.hidden; });
    const idx = visible.findIndex(function(p){ return p.id === 'peru-tourism'; });
    const next = visible[(idx + 1) % visible.length];
    document.getElementById('next-link').href = next.url;
    function setNextTitle() {
      const title = (window.TRANSLATIONS || {})['project.' + next.id + '.title'];
      if (title) document.getElementById('next-title').textContent = title;
    }
    setNextTitle();
    setTimeout(setNextTitle, 500);
  })();
  </script>
</ProjectLayout>

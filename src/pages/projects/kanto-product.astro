---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---
<ProjectLayout title="Kanto: Diseño de Producto">

  <div class="project-header">
    <div class="project-header-left">
      <h1 class="project-title" data-i18n="project.kanto-product.title">Kanto: Diseño de Producto</h1>
      <p class="project-tagline" data-i18n="project.kanto-product.tagline"></p>
    </div>
    <div class="project-header-right">
      <div class="project-meta-grid">
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.category">Categoría</div>
          <div class="meta-value" data-i18n="project.kanto-product.category">Diseño de Producto</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.year">Año</div>
          <div class="meta-value">2024</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.client">Cliente</div>
          <div class="meta-value">Kanto</div>
        </div>
        <div class="meta-item">
          <div class="meta-label" data-i18n="meta.services">Servicios</div>
          <div class="meta-value" data-i18n="project.kanto-product.category">Diseño de Producto</div>
        </div>
      </div>
    </div>
  </div>

  <div class="project-hero">
    <img src="/images/kanto-product/hero.png" alt="Kanto: Diseño de Producto">
  </div>

  <!-- 1: El Problema -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.problem">El Problema</p>
        <h2 class="content-heading" data-i18n="project.kanto-product.s1.heading">Contexto y Desafío</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.kanto-product.s1.body">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum at libero nec nulla elementum fringilla. Cras vehicula felis at dignissim volutpat, integer ac velit nec arcu commodo vulputate. Proin tincidunt nisl sed libero faucibus, a dapibus enim interdum nec.</p>
      </div>
    </div>
  </div>


  <div class="content-section">
    <div class="img-grid-2">
      <img src="/images/kanto-product/01.png" alt="" data-reveal>
      <img src="/images/kanto-product/02.png" alt="" data-reveal style="--reveal-delay:80ms">
    </div>
  </div>


  <!-- 2: Estrategia + Objetivos -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.strategy">Estrategia</p>
        <h2 class="content-heading" data-i18n="project.kanto-product.s2.heading">Objetivos y Métricas</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.kanto-product.s2.body">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo nemo enim ipsam.</p>
      </div>
    </div>
  </div>


  <div class="content-section">
    <div class="img-padded">
      <img src="/images/kanto-product/wide-01.png" alt="" data-reveal>
    </div>
  </div>


  <!-- 3: Proceso -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.process">Proceso</p>
        <h2 class="content-heading" data-i18n="project.kanto-product.s3.heading">Diseño e Iteración</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.kanto-product.s3.body">At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident similique.</p>
      </div>
    </div>
  </div>


  <div class="content-section">
    <div class="img-grid-3">
      <img src="/images/kanto-product/01v.png" alt="" data-reveal>
      <img src="/images/kanto-product/02v.png" alt="" data-reveal style="--reveal-delay:80ms">
      <img src="/images/kanto-product/03v.png" alt="" data-reveal style="--reveal-delay:160ms">
    </div>
  </div>


  <!-- 4: Resultados -->
  <div class="content-section" data-reveal>
    <div class="content-text">
      <div>
        <p class="content-eyebrow" data-i18n="section.results">Resultados</p>
        <h2 class="content-heading" data-i18n="project.kanto-product.s4.heading">Impacto y Aprendizajes</h2>
      </div>
      <div class="content-body">
        <p data-i18n="project.kanto-product.s4.body">Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt neque porro quisquam est qui dolorem ipsum.</p>
      </div>
    </div>
    <div class="metrics-grid" data-reveal style="--reveal-delay:120ms">
      <div class="metric-item">
        <div class="metric-number" data-i18n="project.kanto-product.m1.number">—</div>
        <div class="metric-label" data-i18n="project.kanto-product.m1.label">Métrica clave</div>
      </div>
      <div class="metric-item">
        <div class="metric-number" data-i18n="project.kanto-product.m2.number">—</div>
        <div class="metric-label" data-i18n="project.kanto-product.m2.label">Métrica clave</div>
      </div>
    </div>
  </div>

  <a class="next-project" id="next-link" href="/">
    <p class="next-label" data-i18n="next.project">Siguiente proyecto</p>
    <h2 class="next-title" id="next-title">—</h2>
    <span class="next-arrow">→</span>
  </a>

<script is:inline>
  (function () {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
    const ring = document.getElementById('cursorRing');
    const next = document.getElementById('next-link');
    let mx=0,my=0,cx=0,cy=0;
    document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; }, { passive: true });
    (function loop(){ cx+=(mx-cx)*0.2; cy+=(my-cy)*0.2; ring.style.transform='translate('+(cx-65)+'px,'+(cy-65)+'px)'; requestAnimationFrame(loop); })();
    next.addEventListener('mouseenter', () => ring.classList.add('is-active'));
    next.addEventListener('mouseleave', () => ring.classList.remove('is-active'));
  })();
  (function () {
    const visible = PROJECTS.filter(function(p){ return !p.hidden; });
    const idx = visible.findIndex(function(p){ return p.id === 'kanto-product'; });
    const next = visible[(idx + 1) % visible.length];
    document.getElementById('next-link').href = next.url;
    function setNextTitle() {
      const title = (window.TRANSLATIONS || {})['project.' + next.id + '.title'];
      if (title) document.getElementById('next-title').textContent = title;
    }
    setNextTitle();
    setTimeout(setNextTitle, 500);
  })();
  </script>
</ProjectLayout>

---
import ListingLayout from "../../layouts/ListingLayout.astro";
---
<ListingLayout title="Proyectos" tag="all" description="Proyectos de producto y branding — Sebastian Black, diseñador e ilustrador con base en Perú.">
  <div class="page-header">
    <h1 class="page-title" data-i18n="projects.title">Todos los<br>proyectos</h1>
    <p class="project-count" id="project-count"></p>
  </div>
  <section class="projects-section">
    <h2 class="section-title"><span data-i18n="nav.product">Producto</span> <span class="section-count"></span></h2>
    <div class="projects-grid" data-tag="product"></div>
  </section>
  <section class="projects-section">
    <h2 class="section-title"><span data-i18n="nav.branding">Branding</span> <span class="section-count"></span></h2>
    <div class="projects-grid" data-tag="branding"></div>
  </section>
</ListingLayout>

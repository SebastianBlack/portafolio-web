---
import ListingLayout from "../../layouts/ListingLayout.astro";
import CaseGrid from "../../components/CaseGrid.astro";
import CaseCount from "../../components/CaseCount.astro";
---
<ListingLayout title="Proyectos" tag="all" description="Proyectos de producto, UX/UI y branding — Sebastian Black, diseñador UX/UI y de producto en Lima, Perú.">
  <div class="page-header">
    <h1 class="page-title" data-i18n="projects.title">Todos los<br>proyectos</h1>
    <CaseCount tag="all" />
  </div>
  <section class="projects-section">
    <h2 class="section-title"><span data-i18n="nav.product">Producto</span> <CaseCount tag="product" variant="paren" /></h2>
    <CaseGrid tag="product" />
  </section>
  <section class="projects-section">
    <h2 class="section-title"><span data-i18n="nav.branding">Branding</span> <CaseCount tag="branding" variant="paren" /></h2>
    <CaseGrid tag="branding" />
  </section>
</ListingLayout>

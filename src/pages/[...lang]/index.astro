---
// Portada en español (/) y en inglés (/en/).
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getListedCases } from "../../lib/cases";
import { t, localePath, langPaths, type Lang } from "../../lib/i18n";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = (key: string) => t(lang, key);
const listed = await getListedCases();
---
<Layout lang={lang}>
  <div class="cursor-ring" id="cursorRing" aria-hidden="true">
    <!-- Arrow ↗ inline SVG — black on white circle -->
    <svg viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 28 L28 10 M28 10 H14 M28 10 V24"
            stroke="#0f0e0e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <Nav lang={lang} />

  <main id="main">
  <section class="hero" id="hero">
    <!-- trail images injected by JS -->

    <div class="hero-logo-wrap">
      <img class="hero-logo-ghost" src="/images/ui/logo.png" alt="" aria-hidden="true" draggable="false">
      <img class="hero-logo" src="/images/ui/logo.png" alt="BLACK®" draggable="false">
    </div>

    <div class="hero-logo-mobile" aria-hidden="true">
      <img class="hero-logo-top" src="/images/ui/logo-sebas.png" alt="SEBAS" draggable="false">
      <div class="hero-logo-mobile-slot" id="heroMobileSlot"></div>
      <img class="hero-logo-bottom" src="/images/ui/logo-black.png" alt="BLACK" draggable="false">
    </div>

    <h1 class="hero-tagline" set:html={T('hero.tagline')} />
  </section>

  <!-- SELECTED WORK -->
  <section class="work-section" id="work">
    <h3 class="section-header" data-reveal>{T('work.section-title')}</h3>

    <div class="projects-grid" id="projects-grid">
      {listed.map((c, i) => <ProjectCard c={c} index={i} lang={lang} />)}
    </div>

    <div class="see-all-wrap">
      <a href={localePath(lang, '/projects/')} class="btn-pill">{T('work.see-all')}</a>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about-section" id="about">
    <div>
      <h2 class="about-title" data-reveal set:html={T('about.title')} />

      <p class="about-intro" data-reveal style="--reveal-delay:80ms" set:html={T('about.intro')} />

      <div class="about-details-grid" data-reveal style="--reveal-delay:160ms">
        <div class="about-details-group">
          <div class="about-label">{T('about.services-label')}</div>
          <div class="about-list" set:html={T('about.services-list')} />
        </div>
        <div class="about-details-group">
          <div class="about-label">{T('about.tools-label')}</div>
          <div class="about-list" set:html={T('about.tools-list')} />
        </div>
      </div>
    </div>

    <div class="about-right" data-reveal style="--reveal-delay:80ms">
      <img src="/images/profile.webp" alt={T('about.photo-alt')}>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact-section" id="contact">
    <div class="contact-inner" data-reveal>
      <div class="contact-top-row">
        <div class="contact-eyebrow">{T('contact.eyebrow')}</div>
        <div class="contact-available">
          <span class="availability-dot"></span>
          <span>{T('contact.available')}</span>
        </div>
      </div>
      <h2 class="contact-title" set:html={T('contact.title')} />
      <div class="contact-bottom-row">
        <div class="contact-socials">
          <a href="https://www.instagram.com/sebasblack.pe/" target="_blank" rel="noopener" class="contact-social-link" data-cta="instagram">Instagram ↗</a>
          <a href="https://www.linkedin.com/in/sebastianblack/" target="_blank" rel="noopener" class="contact-social-link" data-cta="linkedin">LinkedIn ↗</a>
          <a href="mailto:hola.sebastianblack@gmail.com" class="contact-social-link contact-email" data-cta="email">hola.sebastianblack@gmail.com</a>
        </div>
        <a href="https://wa.me/51992325564" class="btn-pill" target="_blank" rel="noopener" data-cta="whatsapp">{T('contact.cta')}</a>
      </div>
    </div>
  </section>

  </main>

  <Footer lang={lang} />
  <script is:inline>
  // ─────────────────────────────────────────────────────────────
  //  HERO IMAGE TRAIL  (DOM pool · double-rAF · cached rect)
  // ─────────────────────────────────────────────────────────────
  (function () {
    const SRCS = PROJECTS.filter(function (p) { return !p.hidden; }).flatMap(function (p) { return p.trail; });

    // Valores tomados de inspección del Framer reference
    const POOL_SIZE       = 20;
    const SPAWN_DIST      = 135;
    const SHOW_MS         = 700;
    // Entrada: opacity rápido, scale más suave (Framer Motion)
    const ENTER_OPACITY_MS = 220;
    const ENTER_SCALE_MS   = 420;
    // Salida: opacity rápido, scale lento (por eso se ven items casi a scale 1 con opacity 0)
    const EXIT_OPACITY_MS  = 260;
    const EXIT_SCALE_MS    = 560;
    const ENTER_EASE = 'cubic-bezier(0.22,1,0.36,1)';
    const EXIT_EASE  = 'cubic-bezier(0.4,0,0.6,1)';

    SRCS.forEach(src => { const i = new Image(); i.src = src; });

    const hero = document.getElementById('hero');
    let heroRect = hero.getBoundingClientRect();
    window.addEventListener('resize', () => { heroRect = hero.getBoundingClientRect(); });

    let lastX = null, lastY = null, srcIdx = 0, poolIdx = 0;

    const dot = document.createElement('div');
    dot.className = 'hero-cursor-dot';
    hero.appendChild(dot);

    const pool = Array.from({ length: POOL_SIZE }, () => {
      const el = document.createElement('div');
      el.className = 'hero-trail';
      el.style.cssText = 'position:absolute;left:0;top:0;width:245px;height:170px;background-size:cover;background-position:center;pointer-events:none;z-index:10;opacity:0;will-change:transform,opacity;';
      hero.insertBefore(el, dot);
      return { el, exitTimer: null, version: 0, spawnTime: 0 };
    });

    // Limpia un item de forma inmediata (sin transition) — usado en visibility change y resets
    function hardReset(item) {
      if (item.exitTimer) { clearTimeout(item.exitTimer); item.exitTimer = null; }
      item.version++;
      item.el.style.transition = 'none';
      item.el.style.opacity = '0';
    }

    function spawn(x, y) {
      const item = pool[poolIdx % POOL_SIZE];
      poolIdx++;

      if (item.exitTimer) { clearTimeout(item.exitTimer); item.exitTimer = null; }

      const version = ++item.version;
      const spawnTime = performance.now();
      item.spawnTime = spawnTime;

      const { el } = item;
      const w = 245, h = 170;
      const tx = (x - w / 2).toFixed(1);
      const ty = (y - h / 2).toFixed(1);
      const src = SRCS[srcIdx++ % SRCS.length];

      // Frame 1: posicionar sin transición, scale 0.9, opacity 0
      el.style.transition = 'none';
      el.style.backgroundImage = `url(${src})`;
      el.style.transform = `translate(${tx}px,${ty}px) scale(0.9)`;
      el.style.opacity = '0';

      // Frame 2 (después de 2 rAF para asegurar reflow): animar a scale 1, opacity 1
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (item.version !== version) return;
        // Stale guard: si rAF se demoró (tab background), no animar entrada
        if (performance.now() - spawnTime > SHOW_MS) {
          el.style.opacity = '0';
          return;
        }
        el.style.transition = `transform ${ENTER_SCALE_MS}ms ${ENTER_EASE}, opacity ${ENTER_OPACITY_MS}ms ease-out`;
        el.style.transform  = `translate(${tx}px,${ty}px) scale(1)`;
        el.style.opacity    = '1';
      }));

      // Después de SHOW_MS: salir (opacity rápida, scale lento)
      item.exitTimer = setTimeout(() => {
        if (item.version !== version) return;
        el.style.transition = `transform ${EXIT_SCALE_MS}ms ${EXIT_EASE}, opacity ${EXIT_OPACITY_MS}ms ease-in`;
        el.style.transform  = `translate(${tx}px,${ty}px) scale(0.9)`;
        el.style.opacity    = '0';
        item.exitTimer = null;
      }, SHOW_MS);

      lastX = x;
      lastY = y;
    }

    const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

    if (isTouchDevice) {
      // Mobile / touch: layout SEBAS / [imagen] / BLACK con animación de
      // entrada en 3 fases (ver CSS .hero-logo-mobile-*). Sólo necesitamos
      // setear la primera imagen ANTES de que la animación arranque, y
      // luego iniciar el cycle cuando termine la expansión (~1.8s).
      dot.remove();
      pool.forEach(p => p.el.remove());

      const mobileSlot = document.getElementById('heroMobileSlot');
      let mIdx = 0;
      mobileSlot.style.backgroundImage = `url(${SRCS[mIdx++ % SRCS.length]})`;
      function cycle() {
        mobileSlot.style.backgroundImage = `url(${SRCS[mIdx++ % SRCS.length]})`;
      }
      // 1.2s delay del rect + 0.55s duración = 1.75s. Damos +50ms de buffer.
      setTimeout(() => setInterval(cycle, 500), 1800);
    } else {
      hero.addEventListener('mouseenter', (e) => {
        heroRect = hero.getBoundingClientRect();
        const x = e.clientX - heroRect.left;
        const y = e.clientY - heroRect.top;
        lastX = x; lastY = y;
        dot.style.left    = x + 'px';
        dot.style.top     = y + 'px';
        dot.style.opacity = '1';
      }, { passive: true });

      hero.addEventListener('mousemove', (e) => {
        const x  = e.clientX - heroRect.left;
        const y  = e.clientY - heroRect.top;
        dot.style.left = x + 'px';
        dot.style.top  = y + 'px';
        if (lastX !== null) {
          const dx = x - lastX, dy = y - lastY;
          if (Math.hypot(dx, dy) >= SPAWN_DIST) spawn(x, y);
        }
      }, { passive: true });

      hero.addEventListener('mouseleave', () => {
        lastX = null; lastY = null;
        if (dot) dot.style.opacity = '0';
        pool.forEach((item) => {
          if (item.exitTimer) { clearTimeout(item.exitTimer); item.exitTimer = null; }
          item.version++;
          item.el.style.transition = `opacity ${EXIT_OPACITY_MS}ms ${EXIT_EASE}`;
          item.el.style.opacity    = '0';
        });
      }, { passive: true });
    }

    // Visibility change: si la tab se oculta, reset duro de TODO el pool.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        pool.forEach(hardReset);
        lastX = null; lastY = null;
        if (dot && dot.parentNode) dot.style.opacity = '0';
      }
    });

    // Página oculta o usuario sale de la ventana → también limpiar
    window.addEventListener('blur', () => {
      pool.forEach(hardReset);
      lastX = null; lastY = null;
      if (dot && dot.parentNode) dot.style.opacity = '0';
    });
  })();

  // ─────────────────────────────────────────────────────────────
  //  WORK SECTION CURSOR (skip en touch devices)
  // ─────────────────────────────────────────────────────────────
  (function () {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;

    const ring   = document.getElementById('cursorRing');
    const cards  = document.querySelectorAll('.project-card');

    let mx = 0, my = 0;
    let cx = 0, cy = 0;

    document.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    }, { passive: true });

    (function loop() {
      cx += (mx - cx) * 0.25;
      cy += (my - cy) * 0.25;
      ring.style.left = cx + 'px';
      ring.style.top  = cy + 'px';
      requestAnimationFrame(loop);
    })();

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => ring.classList.add('is-active'));
      card.addEventListener('mouseleave', () => ring.classList.remove('is-active'));
    });

    document.addEventListener('mouseleave', () => ring.classList.remove('is-active'));
  })();

  // ─────────────────────────────────────────────────────────────
  //  SCROLL REVEAL
  // ─────────────────────────────────────────────────────────────
  (function () {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el    = entry.target;
        const delay = el.style.getPropertyValue('--reveal-delay') || '0ms';
        el.style.transitionDelay = delay;
        el.classList.add('is-visible');
        observer.unobserve(el);
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
  })();
  </script>
  <script is:inline>
  (function () {
    const btn = document.getElementById('navHamburger');
    const menu = document.getElementById('navMobile');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      const open = menu.classList.toggle('is-open');
      btn.classList.toggle('is-open', open);
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.style.overflow = open ? 'hidden' : '';
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.remove('is-open');
        btn.classList.remove('is-open');
        menu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  })();
  </script>
</Layout>

---
import ListingLayout from "../../../layouts/ListingLayout.astro";
import CaseGrid from "../../../components/CaseGrid.astro";
import CaseCount from "../../../components/CaseCount.astro";
import { t, langPaths, type Lang } from "../../../lib/i18n";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
---
<ListingLayout lang={lang} title={t(lang, 'seo.projects.title')} tag="all" description={t(lang, 'seo.projects.description')}>
  <div class="page-header">
    <h1 class="page-title" set:html={t(lang, 'projects.title')} />
    <CaseCount tag="all" lang={lang} />
  </div>
  <section class="projects-section" id="product" data-section>
    <h2 class="section-title"><span>{t(lang, 'nav.product')}</span> <CaseCount tag="product" lang={lang} variant="paren" /></h2>
    <CaseGrid tag="product" lang={lang} />
  </section>
  <section class="projects-section" id="branding" data-section>
    <h2 class="section-title"><span>{t(lang, 'nav.branding')}</span> <CaseCount tag="branding" lang={lang} variant="paren" /></h2>
    <CaseGrid tag="branding" lang={lang} />
  </section>
</ListingLayout>

    <p class="next-label" data-i18n="next.project">Siguiente proyecto</p>
    <h2 class="next-title" id="next-title">—</h2>
    <span class="next-arrow">→</span>
  </a>

<script is:inline>
  (function () {
    if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) return;
    const ring = document.getElementById('cursorRing');
    const next = document.getElementById('next-link');
    let mx=0,my=0,cx=0,cy=0;
    document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; }, { passive: true });
    (function loop(){ cx+=(mx-cx)*0.14; cy+=(my-cy)*0.14; ring.style.left=cx+'px'; ring.style.top=cy+'px'; requestAnimationFrame(loop); })();
    next.addEventListener('mouseenter', () => ring.classList.add('is-active'));
    next.addEventListener('mouseleave', () => ring.classList.remove('is-active'));
  })();
  (function () {
    const visible = PROJECTS.filter(function(p){ return p.published; });
    const idx = visible.findIndex(function(p){ return p.id === 'kuyrapet-coderhouse'; });
    const next = visible[(idx + 1) % visible.length];
    document.getElementById('next-link').href = next.url;
    function setNextTitle() {
      const title = (window.TRANSLATIONS || {})['project.' + next.id + '.title'];
      if (title) document.getElementById('next-title').textContent = title;
    }
    setNextTitle();
    setTimeout(setNextTitle, 500);
  })();

  // Índice: marca la sección visible; en celular funciona como desplegable
  (function () {
    const toc = document.querySelector('.kp-toc');
    const toggle = toc.querySelector('.kp-toc-toggle');
    const current = toc.querySelector('.kp-toc-current');
    function setOpen(open) {
      toc.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () { setOpen(!toc.classList.contains('is-open')); });
    toc.addEventListener('keydown', function (e) { if (e.key === 'Escape' && toc.classList.contains('is-open')) { setOpen(false); toggle.focus(); } });
    document.addEventListener('click', function (e) { if (!toc.contains(e.target)) setOpen(false); });

    const links = document.querySelectorAll('.kp-toc a');
    links.forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
    const map = {};
    links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
    const obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (a) { a.removeAttribute('aria-current'); });
        const a = map[e.target.id];
        if (!a) return;
        a.setAttribute('aria-current', 'true');
        current.textContent = a.textContent.trim().replace(/^(\d+)\s+/, '$1 · ');
        // Desplaza solo la barra del índice, nunca la página
        const ol = a.closest('ol');
        const left = a.offsetLeft - ol.offsetLeft;
        if (left < ol.scrollLeft || left + a.offsetWidth > ol.scrollLeft + ol.clientWidth) {
          ol.scrollTo({ left: left - 16, behavior: 'smooth' });
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    Object.keys(map).forEach(function (id) { const s = document.getElementById(id); if (s) obs.observe(s); });
  })();

  // Lightbox de tableros: <dialog> nativo (Esc cierra y el foco vuelve al botón)
  (function () {
    const dlg = document.getElementById('kpLightbox');
    const body = dlg.querySelector('.kp-lightbox-body');
    let opener = null;
    document.querySelectorAll('.kp-zoom').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const img = btn.querySelector('img');
        if (!img) return;
        opener = btn;
        body.innerHTML = '';
        const big = document.createElement('img');
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        body.appendChild(big);
        dlg.showModal();
        document.body.style.overflow = 'hidden';
      });
    });
    dlg.querySelector('.kp-lightbox-close').addEventListener('click', function () { dlg.close(); });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', function () {
      document.body.style.overflow = '';
      if (opener) opener.focus();
    });
  })();
</script>
</ProjectLayout>

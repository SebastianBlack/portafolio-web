---
import "../styles/global.css";

const SITE = 'https://www.sebastian-black.com';
const OG_IMAGE = `${SITE}/images/ui/og-image.jpg`;
const TITLE = 'Sebastian Black — Designer & Illustrator';
const DESCRIPTION = 'Diseñador e ilustrador con base en Perú, especializado en branding y desarrollo de productos.';
const URL = SITE + '/';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="X0t242R3Z2I9SCUPX2stPGmoAlkf49DCih9QMWR_94A" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION}>
  <link rel="canonical" href={URL}>

  <meta property="og:type" content="website">
  <meta property="og:url" content={URL}>
  <meta property="og:site_name" content="Sebastian Black">
  <meta property="og:title" content={TITLE}>
  <meta property="og:description" content={DESCRIPTION}>
  <meta property="og:image" content={OG_IMAGE}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Sebastian Black — Portfolio">
  <meta property="og:locale" content="es_PE">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={URL}>
  <meta name="twitter:title" content={TITLE}>
  <meta name="twitter:description" content={DESCRIPTION}>
  <meta name="twitter:image" content={OG_IMAGE}>

  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/ui/favicon.png?v=3">
  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,700&display=swap" rel="stylesheet">
  <script is:inline src="/js/projects.js"></script>
  <script is:inline src="/js/i18n.js"></script>
  <script is:inline src="/js/contact.js"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-8B50J8PMQ0"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-8B50J8PMQ0');
  </script>
</head>
<body>
  <slot />
</body>
</html>
